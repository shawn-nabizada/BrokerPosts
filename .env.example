# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID, Web app)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob — set automatically on Vercel when you connect a Blob store.
# For local dev, run: vercel link && vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
